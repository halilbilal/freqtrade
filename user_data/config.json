  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "info",
    "jwt_secret_key": "something_secret",
    "username": "admin",
    "password": "admin"
  },
  "pairlists": [
    {
        "method": "StaticPairList",
        "pairs": [
            "ETH/USD",
            "BTC/USD"
        ]
    }
