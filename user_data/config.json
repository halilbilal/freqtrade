{
  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "pair_whitelist": ["ETH/USD"],
    "pair_blacklist": [".*"],
    "ccxt_config": {},
    "ccxt_async_config": {}
  },
  "stake_currency": "USD",
  "stake_amount": "unlimited",
